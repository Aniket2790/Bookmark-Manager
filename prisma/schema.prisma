generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  bookmarks Bookmark[]

  @@index([name])
}

model Bookmark {
  id        String   @id @default(uuid())
  title     String
  url       String
  tags      String[]
  folderId  String
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([title])
}
